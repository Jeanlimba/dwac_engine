# =============================================================================
# Sécurité du dossier d'uploads
# -----------------------------------------------------------------------------
# Empêche l'exécution de tout script (PHP, CGI...) déposé ici. Sans cette
# protection, un fichier malveillant uploadé (shell.php) deviendrait exécutable
# à distance (RCE). Défense en profondeur : désactivation du moteur PHP +
# neutralisation des handlers + refus d'accès aux extensions exécutables.
# =============================================================================

# mod_php : désactive le moteur PHP pour ce dossier.
# (php_flag est autorisé en .htaccess ; php_admin_flag ne l'est PAS.)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Neutralise tout handler/type qui ferait interpréter ces extensions
# (utile notamment en FastCGI où php_flag n'a pas d'effet).
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar .cgi .pl .py
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .phar
</IfModule>

# Refuse l'accès direct aux fichiers exécutables / scripts (toutes configs).
<FilesMatch "(?i)\.(php|php3|php4|php5|php7|phtml|phps|phar|pht|cgi|pl|py|sh|asp|aspx|jsp|exe|com|bat|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
