# =============================================================================
# Modèle de configuration — copier en .env et renseigner les vraies valeurs.
# NE JAMAIS committer le fichier .env réel (il est ignoré par git).
# =============================================================================

# --- CONFIGURATION LOCALE (développement) ---
LOCAL_DB_HOST=localhost
LOCAL_DB_NAME=evolution
LOCAL_DB_USER=root
LOCAL_DB_PASS=

# --- CONFIGURATION EN LIGNE (PRODUCTION) ---
ONLINE_DB_HOST=
ONLINE_DB_NAME=
ONLINE_DB_USER=
ONLINE_DB_PASS=

# Application Settings
SITENAME="DWAC Engine"
APPVERSION=1.0.0

# Forcer l'affichage des erreurs même hors environnement local (true/false).
# Laisser à false en production.
APP_DEBUG=false

# Mot de passe par défaut des nouveaux comptes.
# À RÉGÉNÉRER : utiliser une valeur forte et imposer le changement au 1er login.
DEFAULT_PASSWORD=

# --- PRÉSENCE : API d'ingestion (pont collecteur local -> evolution en ligne) ---
# Secret partagé HMAC-SHA256 entre le collecteur local et le serveur (valeur forte).
PRESENCE_API_SECRET=
# Tenant auquel sont rattachés les pointages reçus (mono-tenant pour l'instant).
PRESENCE_TENANT_ID=1
